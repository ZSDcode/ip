<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.VBox?>

<AnchorPane xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="Ui.MainWindow"
            prefHeight="600" prefWidth="400">
    <ScrollPane fx:id="scrollPane" prefHeight="530" AnchorPane.topAnchor="0">
        <VBox fx:id="dialogContainer" fillWidth="true"/>
    </ScrollPane>
    <TextField fx:id="userInput" onAction="#handleUserInput"
               AnchorPane.bottomAnchor="0" AnchorPane.leftAnchor="0" prefWidth="325"/>
    <Button fx:id="sendButton" onAction="#handleUserInput" text="Send"
            AnchorPane.bottomAnchor="0" AnchorPane.rightAnchor="0"/>
</AnchorPane>
